# Copy to `.env` and fill in only what you actually use. `.env` is gitignored.
#
# Ronin needs NONE of these to run. The $0 lane — local weights via mlx or a local
# OpenAI-compatible server — takes no key at all; see examples/models.local.toml and
# docs/FREE_TRAINING.md. Every variable below buys one specific capability.
#
# How keys reach the agent (v2, `src/ronin`)
# -----------------------------------------
# Ronin never hardcodes a key name. Your `models.toml` says `api_key_env = "..."` and
# that names the variable to read — so this file is a convention, not a schema, and
# adding a provider means naming its variable in TOML rather than patching Python.
# A model entry with no `api_key_env` (a local server, Ollama, mlx) reads nothing.

# ---------------------------------------------------------------------------
# Hosted model providers — set the one(s) your models.toml names
# ---------------------------------------------------------------------------
# The default in `ronin.providers.router` when a config names no variable.
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# web_search — off unless you name a provider here
# ---------------------------------------------------------------------------
# Unset means the `web_search` tool does not exist in the session at all. That is
# deliberate: a search tool with no backend errors on every call and teaches the model
# to keep trying it. `web_fetch` needs nothing here and always works.
#
# One of: brave | tavily | searxng
RONIN_SEARCH_PROVIDER=
# brave — general web index, documented JSON API, free tier. Needs:
BRAVE_API_KEY=
# tavily — built for agents, longer snippets, free tier. Needs:
TAVILY_API_KEY=
# searxng — a metasearch instance you run yourself: no key, no account, nobody
# learning what your agent searches for. Point this at it (its JSON API must be
# enabled in the instance's settings). Required for searxng, optional for the others
# if you need to override their endpoint.
#   e.g. RONIN_SEARCH_ENDPOINT=http://localhost:8888/search
RONIN_SEARCH_ENDPOINT=

# ---------------------------------------------------------------------------
# Agent behaviour (v1, `packages/cli`) — all optional, all with working defaults
# ---------------------------------------------------------------------------
# Where Ronin keeps sessions, memory and the cost ledger. Defaults to ~/.ronin.
RONIN_HOME=
# Pin a model for one run without editing config.
RONIN_PINNED=
# Path to a fine-tuned LoRA adapter for the local lane.
RONIN_ADAPTER=
# Constrain local decoding to the tool-call grammar (see docs/FREE_TRAINING.md).
RONIN_GRAMMAR=
# Opt-in extra review passes. Off unless set.
RONIN_SELF_VERIFY=
RONIN_GROUNDING_CHECK=
RONIN_HUNK_REVIEW=

# ---------------------------------------------------------------------------
# Telegram bridge (docs/TELEGRAM.md) — read-only agent, outbound-only, allowlisted
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids. EMPTY MEANS THE BOT ANSWERS NOBODY, which is the
# safe default: with no allowlist it only tells a chat its own id so you can add it.
TELEGRAM_ALLOWED_CHAT_IDS=
# Root the read-only file agent somewhere narrower than your home directory.
RONIN_TELEGRAM_ROOT=

# ---------------------------------------------------------------------------
# MCP servers — only what a server you enable actually needs
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITLAB_TOKEN=
LINEAR_API_KEY=
NOTION_TOKEN=
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------------
# No telemetry endpoint variable. Telemetry is off, consent-gated, and no sender is
# configured — `ronin2 telemetry status` says so. Nothing is transmitted even with
# consent granted, so there is no endpoint to point anywhere.
#
# No variable turns off the approval gate. Destructive and payment actions require
# approval by design, and an env var that disables that would be the first thing a
# prompt injection reached for.
